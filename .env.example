# Supabase project credentials.
# Copy this file to `.env.local` and fill in your project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If these are left empty, the app falls back to a local, browser-only
# data store (localStorage) so the UI can be developed and tried out
# without a Supabase project. See src/lib/localStore.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
